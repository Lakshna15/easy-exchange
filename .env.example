# Copy this file to .env before running the app (see README.md).

# Where the SQLite database file lives. The folder is created if it is missing.
DATABASE_FILE=data/easy-exchange.db

# Signs the login cookie. Use at least 32 random characters. This value is only for local demos;
# make your own with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=local-demo-only-replace-me-with-32-plus-random-characters
